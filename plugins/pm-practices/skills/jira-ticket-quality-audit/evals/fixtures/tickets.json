        },
        "summary": "Empty reservation search returns 500",
        "description": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Why: Staff cannot view the empty-result state."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Steps: On test build 2, sign in as staff; GET /reservations?q=zz-no-match in a seeded empty account."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Expected: HTTP 200 with an empty array, per rules.md Search."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Actual: HTTP 500, body {error: no records}. Repeated twice with the same request. No browser dependency."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "AC: That query returns 200 and []; existing matches remain unchanged."
                }
              ]
            }
          ]
        },
