        "summary": "Add cancellation confirmation dialog",
        "description": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Why: Prevent accidental cancellation."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "What: Show Confirm/Keep dialog before cancellation. Priority: High. Parent: DEMO-9. Blocked by DEMO-5's design decision."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "AC: Keep preserves the reservation. Confirm cancels it once. Keyboard focus begins on Keep; Escape keeps the reservation. Source: rules.md, Confirmation."
                }
              ]
            }
          ]
        },
        "priority": {
